# Postgres for the whitelist (Neon). Without it the whitelist form reports "opens soon".
DATABASE_URL=

# $ROYAL contract address, shown with a copy button. Read at build time.
NEXT_PUBLIC_ROYAL_CA=

# Local development only: 1 opens /play to any connected wallet, without the launch wait or the $ROYAL hold.
# Ignored by `next build`, so it never applies to a deployed site.
NEXT_PUBLIC_DEV_OPEN_PLAY=
