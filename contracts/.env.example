# Copy to .env and fill in. Never commit .env.

# The treasury multisig (Safe) that owns every contract.
OWNER=
# XOM stock token on Robinhood Chain mainnet (chain ID 4663).
XOM=0xf9B46d3D1B22199D4D1025a9cEDB540A33F1a2d5
# Where rig mint proceeds go.
TREASURY=

# Export rules: EXPORT_BARRELS bbl earn EXPORT_USD_MICROS millionths of a dollar of XOM,
# up to EXPORT_DAILY_QUOTA bbl per rig per day.
EXPORT_BARRELS=300
EXPORT_USD_MICROS=1000
EXPORT_DAILY_QUOTA=5000

# Fee splitter payees.
PAYEE_COSTS=
PAYEE_RESERVE=
PAYEE_XOM_BUYER=
PAYEE_DEV=
PAYEE_BUYBACK=
PAYEE_PRIZES=
# Running costs per 30 days and the reserve target, in wei (about $500 and $1,500 of ETH).
COST_CAP_WEI=
RESERVE_TARGET_WEI=

RIG_BASE_URI=https://barrelroyale.io/rigs/
